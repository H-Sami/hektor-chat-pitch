{
  "name": "hektor-chat-pitch",
  "private": true,
  "type": "module",
  "description": "Slidev pitch deck for an AI chat agent on hektormobil.se/kontakta-oss: local build, screenshot verification and PDF export, with the hosted slidev-mcp publish path mounted and ready.",
  "scripts": {
    "build": "node scripts/build-publish.mjs",
    "build:local": "node scripts/build-publish.mjs --out slides.local.md --keep-placeholder",
    "slides:inspect": "node scripts/inspect-slides.mjs",
    "slides:shoot": "node scripts/shoot-slides.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "serve": "node scripts/serve-dist.mjs 8099 dist",
    "pdf:info": "node scripts/pdf-info.mjs Hektor-AI-Chat-Pitch.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "playwright-core": "^1.63.0"
  }
}
