{
  "name": "hektor-chat-pitch",
  "private": true,
  "type": "module",
  "description": "Hektor Agent management pitch: Slidev presentation, local preview and PDF export.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "slidev slides.md --port 3030",
    "build": "slidev build slides.md --out dist --base /",
    "build:pages": "slidev build slides.md --out ghdest --base /hektor-chat-pitch/",
    "export": "slidev export slides.md --format pdf --output Hektor-AI-Chat-Pitch.pdf",
    "verify": "node scripts/verify-deck.mjs",
    "build:local": "node scripts/build-publish.mjs --out slides.local.md --keep-placeholder",
    "slides:inspect": "node scripts/inspect-slides.mjs",
    "slides:shoot": "node scripts/shoot-slides.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "serve": "node scripts/serve-dist.mjs 8099 dist",
    "pdf:info": "node scripts/pdf-info.mjs Hektor-AI-Chat-Pitch.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "playwright-core": "^1.63.0"
  }
}
